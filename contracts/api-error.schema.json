{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dancing-with-the-sars:contracts:api-error:1.0",
  "title": "Dancing with the SARs API error response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "enum": ["invalidRequest", "parcelNotFound", "internalError"] },
        "message": { "type": "string", "minLength": 1 },
        "requestId": { "type": ["string", "null"] }
      },
      "required": ["code", "message", "requestId"]
    }
  },
  "required": ["error"]
}
